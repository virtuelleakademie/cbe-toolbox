{
  "name": "@cbe/app",
  "version": "0.1.23",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck:i18n": "tsc -p tsconfig.i18n.json",
    "build": "npm run typecheck:i18n && electron-vite build",
    "start": "electron-vite preview",
    "icons:generate": "node scripts/icons-generate.mjs",
    "icons:check": "node scripts/icons-check.mjs",
    "icons:inspect:linux": "node scripts/inspect-linux-icon-artifact.mjs",
    "pack:mac": "node scripts/default-llm-config.mjs && electron-vite build && electron-builder --mac --arm64 --dir",
    "dist:mac": "node scripts/default-llm-config.mjs && electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:win": "node scripts/default-llm-config.mjs && electron-vite build && electron-builder --win --x64 --publish never",
    "dist:linux": "node scripts/default-llm-config.mjs && electron-vite build && electron-builder --linux --x64 --publish never",
    "checksums": "node scripts/checksums.mjs release",
    "test": "vitest run && vitest run --config vitest.electron.config.ts",
    "test:electron": "CBE_ELECTRON_LAYOUT=required vitest run --config vitest.electron.config.ts"
  },
  "build": {
    "appId": "com.bridgebinary.cbe-toolbox",
    "productName": "CBE Toolbox",
    "artifactName": "CBE-Toolbox-${version}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "buildResources": "buildResources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../skills",
        "to": "skills"
      },
      {
        "from": "../../corpus",
        "to": "corpus"
      },
      {
        "from": "build-defaults",
        "to": "defaults"
      },
      {
        "from": "buildResources/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "icon": "buildResources/icon.icns",
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "icon": "buildResources/icon.icns"
    },
    "win": {
      "icon": "buildResources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "buildResources/icons",
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "buildResources/icon.ico",
      "uninstallerIcon": "buildResources/icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://cbe-stories.pages.dev/update"
      }
    ]
  },
  "dependencies": {
    "@cbe/corpus-schema": "*",
    "@cbe/pi-bridge": "*",
    "electron-updater": "^6.3.9",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "7.8.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "36.9.5",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "sharp": "0.35.5",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
